        "TEST_X_PATH = os.path.join(DATA_DIR, \"test\", \"camelyonpatch_level_2_split_test_x.h5\")\n",
        "REF_CFG_PATH = os.path.join(PROJECT_ROOT, \"experiments\", \"stain_reference\", \"stain_reference.json\")\n",
        "# From: preprocess_histopath_h5.py --stain-multi-ref --preprocessed-subdir preprocessed_multi_ref\n",
        "PREPROC_OUT_DIR = os.path.join(DATA_DIR, \"preprocessed_multi_ref\")\n",
        "QA_TRAIN_NPZ = os.path.join(PREPROC_OUT_DIR, \"train_qa_samples.npz\")\n",
