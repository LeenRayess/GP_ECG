        "print(\"Project root:\", PROJECT_ROOT)\n",
        "print(\"Train:\", TRAIN_X_PATH)\n",
        "print(\"Test:\", TEST_X_PATH)\n",
        "print(\"Preprocessed (multi-ref):\", PREPROC_OUT_DIR)\n",
        "print(\"QA npz:\", QA_TRAIN_NPZ)"
      ]
